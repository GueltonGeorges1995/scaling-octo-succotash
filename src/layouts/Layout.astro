---
import { lireCategories } from '../recettes/acces-recettes';
import { NOM_DU_SITE } from '../site';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
	titre: string;
}

const { titre } = Astro.props;
const base = import.meta.env.BASE_URL;
const categories = await lireCategories();
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta name="generator" content={Astro.generator} />
		<title>{titre}</title>
	</head>
	<body>
		<header class="border-b border-separateur print:hidden">
			<div class="mx-auto flex max-w-page flex-wrap items-baseline gap-x-6 gap-y-1 px-4 py-3">
				<a href={base} class="font-titre text-2xl font-semibold text-texte no-underline">{NOM_DU_SITE}</a>
				{
					categories.length > 0 && (
						<nav aria-label="Catégories">
							<ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
								{categories.map(({ nom, slug }) => (
									<li>
										<a href={`${base}categorie/${slug}/`}>{nom}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
			</div>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
